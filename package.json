{
  "name": "toolbox",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "rm -rf dist && concurrently \"npm:dev:11ty\" \"npm:dev:vite\"",
    "dev:11ty": "eleventy --watch",
    "dev:vite": "vite",
    "build": "rm -rf dist && eleventy && vite build",
    "format": "npx prettier --write src/**/*",
    "format:check": "npx prettier --check src/**/*"
  },
  "dependencies": {
    "@nabucasa/sl-web-tools": "^0.12.0",
    "improv-wifi-sdk": "^1.4.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^24.6.2",
    "concurrently": "^9.2.1",
    "html-minifier-terser": "^7.2.0",
    "prettier": "^3.6.2",
    "vite": "^7.1.2"
  }
}
