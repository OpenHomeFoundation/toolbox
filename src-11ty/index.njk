---
layout: base.html
title: Device Toolbox
description: Flash firmware, configure devices, and manage your smart home hardware directly from your browser
permalink: /index.html
---

<style>
.home-container {
  display: block;
  min-height: 100vh;
  background: var(--app-bg-primary);
  color: var(--app-text-primary);
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px;
}

.hero {
  text-align: center;
  padding: 40px 20px;
  margin-bottom: 40px;
}

.hero .title {
  font-size: 2.5rem;
  margin-bottom: 10px;
  font-weight: 600;
  color: var(--app-text-primary);
}

.hero p {
  font-size: 1.1rem;
  color: var(--app-text-secondary);
  margin: 0;
  max-width: 600px;
  margin: 0 auto;
  line-height: 1.6;
}

.tools-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 20px;
  margin-bottom: 40px;
}

/* Tool card styles */
.tool-card {
  display: block;
  background: var(--app-bg-card);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 8px var(--app-shadow);
  transition: all 0.3s ease;
  height: 100%;
  text-decoration: none;
  color: inherit;
  cursor: pointer;
}

.tool-card:hover {
  box-shadow: 0 4px 16px var(--app-shadow-hover);
  transform: translateY(-2px);
}

.tool-card .card-image {
  width: 100%;
  height: 200px;
  object-fit: cover;
  background: #f0f0f0;
  display: block;
}

.tool-card.wled .card-image {
  object-fit: contain;
}

.tool-card .card-content {
  padding: 20px;
  display: flex;
  flex-direction: column;
  min-height: 180px;
}

.tool-card .card-header {
  margin-bottom: 12px;
}

.tool-card .card-title {
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--app-text-primary);
  margin: 0 0 8px 0;
  line-height: 1.3;
}

.tool-card .card-category {
  display: inline-block;
  background: var(--app-category-bg);
  color: var(--app-category-text);
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 0.75rem;
  font-weight: 500;
  margin-bottom: 8px;
}

.tool-card .card-description {
  color: var(--app-text-secondary);
  line-height: 1.5;
  margin: 0;
  flex: 1;
}

@media (max-width: 768px) {
  .hero .title {
    font-size: 2rem;
  }

  .tools-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .home-container {
    padding: 16px;
  }
}

@media (max-width: 480px) {
  .tool-card .card-content {
    padding: 16px;
  }
}
</style>

<div class="home-container">
  <div class="hero">
    <div class="title">Device Toolbox</div>
    <p>
      Flash firmware, configure devices, and manage your smart home hardware
      directly from your browser. No installation required.
    </p>
  </div>

  <div class="tools-grid">
    {%- for tool in collections.tools -%}
    <a href="{{ tool.url }}" class="tool-card {{ tool.slug }}" {% if tool.url.startsWith('http') and not tool.url.includes('#') %}target="_blank" rel="noopener noreferrer"{% endif %}>
      <img src="{{ tool.image }}" alt="{{ tool.title }}" class="card-image" />

      <div class="card-content">
        <div class="card-header">
          {%- if tool.category -%}
          <div class="card-category">{{ tool.category }}</div>
          {%- endif -%}
          <h3 class="card-title">{{ tool.title }}</h3>
        </div>

        <p class="card-description">{{ tool.description }}</p>
      </div>
    </a>
    {%- endfor -%}
  </div>
</div>
